{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/barrier-in-education--education.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/barrier-in-education--education","type":"Concept","prefLabel":{"en":"barrier in education (education)"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"Conditions within the educational environment that hinder or limit everyone’s ability to access, participate, learn and develop on an equal footing, regardless of their characteristics, needs or circumstances."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["Generally speaking, these include attitudinal barriers linked to stereotypes, discrimination or low expectations; institutional barriers arising from educational policies that lack inclusivity, a lack of resources, or poor coordination and organisation of support services; curricular barriers, linked to inflexible teaching methods or rigid assessment practices; and barriers relating to accessibility and participation."]},"notation":["4.4.2"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/universal-design-for-learning","prefLabel":{"en":"universal design for learning"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/reasonable-accommodation","prefLabel":{"en":"reasonable accommodation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/inclusive-education","prefLabel":{"en":"inclusive education"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/inclusion--education","prefLabel":{"en":"inclusion (education)"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/","title":{"en":"FRIDA Common Dictionary"}}],"inSchemeAll":[{"id":"https://m-lancini.github.io/fr