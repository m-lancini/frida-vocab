{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/stereotypes.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/stereotypes","type":"Concept","prefLabel":{"en":"stereotypes"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"Preconceived opinions and beliefs about individuals or groups, independent of an assessment of the specific conditions of each individual case, and resulting from a prior process of overgeneralisation and oversimplification."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["Stereotypes can relate both to the characteristics, attitudes, abilities and social roles that people belonging to a particular social group are assumed to possess (descriptive dimension), and to the characteristics, attitudes, abilities and social roles that these people are expected to possess (prescriptive dimension). In both cases, stereotypes are never neutral, because they create a hierarchy among subjects and contribute to reproducing asymmetries in power relations."]},"notation":["6.10"],"example":null,"narrower":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/gender-stereotypes","prefLabel":{"en":"gender stereotypes"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectional-stereotype","prefLabel":{"en":"intersectional stereotype"}}],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-6","prefLabel":{"en":"Equality, discrimination and stereotyping"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/ethnocentrism","prefLabel":{"en":"ethnocentrism"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/ableism","prefLabel":{"en":"ableism"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/bias","prefLabel":{"en":"bias"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/stigma","prefLabel":{"en":"stigma"}