{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/best-interests-of-the-child.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/best-interests-of-the-child","type":"Concept","prefLabel":{"en":"best interests of the child"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"A requirement that, in any decision affecting a child or adolescent, their best interests be assessed and weighed as a primary consideration."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["It does not operate as a rule of automatic precedence, but as a criterion to be determined case by case, in the light of each child's circumstances and oriented towards the effective enjoyment of their rights; hence its threefold nature as a substantive right, an interpretative principle and a rule of procedure. Where children with disabilities are concerned, this determination must be made on a basis of equality and non-discrimination, with respect for the evolving capacities of the child and for their identity, and ensuring that they can express their views with appropriate support and the accessibility needed for effective participation."]},"notation":["2.2"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-2","prefLabel":{"en":"Children, family and parental responsibility"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/alternative-care","prefLabel":{"en":"alternative care"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/children-with-disabilities","prefLabel":{"en":"children with disabilities"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/parental-responsibility","prefLabel":{"en":"parental responsibility"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/right-of-the-child-to-be-heard","prefLabel":{"en":"right of the child to be heard"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/situations-of-risk","prefLabel":{"en":"situations of risk"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/child-custody","prefLabel":{"en":"child custody"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/family-mediation","prefLabel":{"en":"family mediation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/vicarious-violence","prefLabel":{"en":"vicarious violence"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/","title":{"en":"FRIDA Common Dictionary"}}],"inSchemeAll":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://m-lancini.github.io/frida-vocab/"}},"staticQueryHashes":["1805648281","3649515864","63159454"],"slicesMap":{}}