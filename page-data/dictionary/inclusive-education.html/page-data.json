{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/inclusive-education.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/inclusive-education","type":"Concept","prefLabel":{"en":"inclusive education"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"An educational principle that recognises, values, and responds to learner diversity."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["Its goal is to eliminate social exclusion resulting from discriminatory attitudes and practices related to race, social class, ethnicity, religion, gender, and disability. Grounded in the belief that education is a fundamental human right and a foundation for a more just society, inclusive education is conceived as a continuous process of identifying and removing barriers to students' presence, participation, and achievement. It places particular emphasis on learners who are at heightened risk of marginalisation, exclusion, or underperformance."]},"notation":["5.3.2"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/education","prefLabel":{"en":"education"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/barrier-in-education--education","prefLabel":{"en":"barrier in education (education)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/universal-design-for-learning","prefLabel":{"en":"universal design for learning"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/inclusion--education","prefLabel":{"en":"inclusion (education)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/personalisation--education","prefLabel":{"en":"personalisation (education)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/special-education","prefLabel":{"en":"special education"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch