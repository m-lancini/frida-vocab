{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/empowerment.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/empowerment","type":"Concept","prefLabel":{"en":"empowerment"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"Expansion of freedom of choice and action that involves increasing one’s authority and control over the resources and decisions that affect one’s life."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["It can also be defined as the act of enabling people to act on their own in order to reach their self-defined goals. Empowerment could be in different facets, ranging from economic, political, social to psychological. The empowerment of historically marginalised groups, such as women, yields positive outcomes not only for the groups themselves but also for the society as a whole of which they are a part, contributing to more inclusive, equitable, and sustainable social development."]},"notation":["1.5"],"example":null,"narrower":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/psychological-empowerment","prefLabel":{"en":"psychological empowerment"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/social-empowerment","prefLabel":{"en":"social empowerment"}}],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-1","prefLabel":{"en":"Autonomy, participation, care and support"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/agency","prefLabel":{"en":"agency"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/autonomy","prefLabel":{"en":"autonomy"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/meaningful-participation","prefLabel":{"en":"meaningful participation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/recovery","prefLabel":{"en":"recovery"}},{"id":"https://m-lancini.github