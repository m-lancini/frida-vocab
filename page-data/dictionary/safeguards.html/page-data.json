{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/safeguards.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/safeguards","type":"Concept","prefLabel":{"en":"safeguards"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"Guarantees that must accompany any measure relating to the exercise of legal capacity in order to prevent abuse."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["Under art. 12.4 CRPD, they must ensure that support respects the person's rights, will and preferences, is free from conflict of interest and undue influence, is proportionate and tailored to the person's circumstances, applies for the shortest possible time and is subject to regular review by a competent, independent and impartial authority or judicial body. They are not a control over the person, but protection against the misuse of support."]},"notation":["10.8"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-10","prefLabel":{"en":"Rights, legal capacity and access to justice"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/accountability","prefLabel":{"en":"accountability"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/legal-capacity","prefLabel":{"en":"legal capacity"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/support-in-decision-making","prefLabel":{"en":"support in decision-making"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/guardianship","prefLabel":{"en":"guardianship"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/will-and-preferences","prefLabel":{"en":"will and preferences"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/","title":{"en":"FRIDA Common D