{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/right-of-the-child-to-be-heard.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/right-of-the-child-to-be-heard","type":"Concept","prefLabel":{"en":"right of the child to be heard"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"The right of every child or adolescent to express their views freely on matters affecting them and to have those views given due weight in accordance with their age and maturity, in any setting and not only before the courts."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["It includes the right to be heard in judicial and administrative proceedings, whether directly or through a representative or an appropriate body. For children with disabilities, it encompasses the use of any mode, means or format of communication – sign language, braille, augmentative and alternative communication – and the availability of accessible environments."]},"notation":["2.6"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-2","prefLabel":{"en":"Children, family and parental responsibility"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/meaningful-participation","prefLabel":{"en":"meaningful participation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/best-interests-of-the-child","prefLabel":{"en":"best interests of the child"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/children-with-disabilities","prefLabel":{"en":"children with disabilities"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/parental-responsibility","prefLabel":{"en":"parental responsibility"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/accessibility","prefLabel":{"en":"accessibility"}},{"id":"https://m-lancini.github.io/frida-vocab/dic