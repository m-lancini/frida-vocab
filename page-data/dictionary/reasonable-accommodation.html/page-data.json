{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/reasonable-accommodation.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/reasonable-accommodation","type":"Concept","prefLabel":{"en":"reasonable accommodation"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"Necessary and appropriate modifications and adjustments which, without imposing a disproportionate or undue burden, are made in a particular case to enable a person with a disability to exercise their fundamental rights and freedoms on an equal basis."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["It is an individualised obligation of immediate application. It is distinct from accessibility and universal design, which are general and anticipatory duties, and from procedural accommodations in the field of justice (art. 13), which are not subject to the same disproportionate-burden limit. The CRPD defines it in art. 2 and treats its denial as a form of discrimination, requiring States to ensure it (art. 5.3). It is a cross-cutting guarantee of the equal exercise of rights and has, in EU law, a clear positive anchor in the field of employment (Directive 2000/78/EC, art. 5; CJEU, HK Danmark, 2013)."]},"notation":["10.7"],"example":null,"narrower":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/reasonable-accommodation-in-employment--employment-law","prefLabel":{"en":"reasonable accommodation in employment (employment law)"}}],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-10","prefLabel":{"en":"Rights, legal capacity and access to justice"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/accessibility","prefLabel":{"en":"accessibility"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/long-term-illness","prefLabel":{"en":"long-term illness"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/universal-design","prefLabel":{"en":"universal design"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/barrier-in-education--education","prefLabel":{"en":"barrier in education (education)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/discrimination","prefLabel":{"en":"discrimination"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/equality","prefLabel":{"en":"equality"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/access-to-justice","prefLabel":{"en":"access to justice"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/procedural-accommodation","prefLabel":{"en":"procedural accommodation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/situations-of-risk","prefLabel":{"en":"situations of risk"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/indirect-discrimination","prefLabel":{"en":"indirect discrimination"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/","title":{"en":"FRIDA Common Dictionary"}}],"inSchemeAll":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://m-lancini.github.io/frida-vocab/"}},"staticQueryHashes":["1805648281","3649515864","63159454"],"slicesMap":{}}