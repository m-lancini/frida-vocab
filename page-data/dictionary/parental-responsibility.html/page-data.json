{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/parental-responsibility.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/parental-responsibility","type":"Concept","prefLabel":{"en":"parental responsibility"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"The set of duties and powers of those who care for, raise, educate, represent and protect a child, always exercised in the child's interest and with respect for the child's evolving capacities."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["It is a function oriented towards the child's well-being, not a power over the child; in some legal systems it takes the form of national institutions such as parental authority. Where the parents have a disability, it also includes the right to receive appropriate assistance in carrying out their child-rearing responsibilities, as well as the prohibition on separating a child from their parents on the ground of disability."]},"notation":["2.5"],"example":null,"narrower":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/child-custody","prefLabel":{"en":"child custody"}}],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-2","prefLabel":{"en":"Children, family and parental responsibility"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/alternative-care","prefLabel":{"en":"alternative care"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/best-interests-of-the-child","prefLabel":{"en":"best interests of the child"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/family","prefLabel":{"en":"family"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/right-of-the-child-to-be-heard","prefLabel":{"en":"right of the child to be heard"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/right-to-marry-and-to-found-