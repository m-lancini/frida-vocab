{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/difference-sensitive-pedagogy.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/difference-sensitive-pedagogy","type":"Concept","prefLabel":{"en":"difference-sensitive pedagogy"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"A pedagogical fundamental orientation and a professional stance promoting a reflective treatment of differences between learners that neither levels difference out (equal treatment as homogenisation) nor uses it for hierarchisation or stigmatisation."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["Difference is recognised as the normal case; the aim is equal worth in difference. The term functions as an umbrella concept spanning several sub-concepts that share this underlying norm but operate on distinct levels of reference, each carrying its own guiding question, understanding of difference, and relation to power."]},"notation":["5.2"],"example":null,"narrower":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/diversity--education","prefLabel":{"en":"diversity (education)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/heterogeneity--education","prefLabel":{"en":"heterogeneity (education)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/inclusion--education","prefLabel":{"en":"inclusion (education)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectionality--education","prefLabel":{"en":"intersectionality (education)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/personalisation--education","prefLabel":{"en":"personalisation (education)"}}],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-5","prefLabel":{"en":"Education"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectionality","prefLabel":{"en