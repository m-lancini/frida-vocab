{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/structural-discrimination.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/structural-discrimination","type":"Concept","prefLabel":{"en":"structural discrimination"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"A set of systemic, institutional, cultural, and spatial mechanisms and relations through which inequalities and relations of domination are produced, normalised, and reproduced over time, relatively independently of individual intentions."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["These dynamics operate organically at a structural and hegemonic level, configuring relations and practices that consolidate power hierarchies among social groups and embed them within the economic, political, and cultural structures of a given social formation. The geo-historically situated forms that result generate conditions of subordination and disadvantage for specific social groups, rendering them ordinary and difficult to recognise and contest."]},"notation":["6.3.8"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/discrimination","prefLabel":{"en":"discrimination"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/meritocracy","prefLabel":{"en":"meritocracy"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/minoritised-groups","prefLabel":{"en":"minoritised groups"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/racism-and-racialisation","prefLabel":{"en":"racism and racialisation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/segregation","prefLabel":{"en":"segregation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/transformative-approach","prefLabel":{"en":"transformative approach"}},{"id":"https://m-lancini.github.io/fri