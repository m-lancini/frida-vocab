{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/formal-education.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/formal-education","type":"Concept","prefLabel":{"en":"formal education"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"A structured and state-regulated educational process delivered through the different levels of the education system."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["It is characterised by a hierarchical organisation, with regulated learning environments, fixed schedules, prescribed curricula, and formal assessment procedures. Its primary purpose is to provide accredited education leading to officially recognised qualifications, which are valued by both the education system and the labour market. Formal education is primarily delivered in schools and other recognised educational institutions."]},"notation":["5.3.1"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/education","prefLabel":{"en":"education"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/lifelong-learning","prefLabel":{"en":"lifelong learning"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/informal-education","prefLabel":{"en":"informal education"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/non-formal-education","prefLabel":{"en":"non-formal education"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/","title":{"en":"FRIDA Common Dictionary"}}],"inSchemeAll":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://m-lancini.github.io/frida-vocab/"}},"staticQueryHashes":["18056482