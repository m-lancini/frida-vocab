{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/harassment.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/harassment","type":"Concept","prefLabel":{"en":"harassment"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"An unwanted conduct related to a protected ground that violates the dignity of a person and creates an intimidating, hostile, or offensive environment. This broadens the notion of discrimination to cover harm in both tangible (employment, housing) and intangible (dignitary) dimensions."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["Harassment can occur in different contexts (work, family, education). It is recognised in many legal systems (e.g., EU Directive 2000/78/EC) as a form of discrimination."]},"notation":["13.6"],"example":null,"narrower":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/sexual-harassment","prefLabel":{"en":"sexual harassment"}}],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/discrimination","prefLabel":{"en":"discrimination"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/employment-discrimination","prefLabel":{"en":"employment discrimination"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/second-order-violence","prefLabel":{"en":"second-order violence"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/","title":{"en":"FRIDA Common Dictionary"}}],"inSchemeAll":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://m-lancini.github.io/frida-vocab/"}},"staticQueryHashes":["1805648281","3649515864","63159454"],"slicesMap":{}}