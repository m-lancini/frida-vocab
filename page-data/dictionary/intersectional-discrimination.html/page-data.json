{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/intersectional-discrimination.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectional-discrimination","type":"Concept","prefLabel":{"en":"intersectional discrimination"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"A form of discrimination in which multiple protected characteristics — such as sex, gender, race, ethnicity, disability, age, religion, sexual orientation — interact in a manner that produces qualitatively distinct and compounded disadvantages."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["These disadvantages cannot be fully understood, proven, or remedied by isolating each ground of discrimination and examining it independently. In particular, legal systems structured around single-axis analysis (e.g., discrimination based solely on gender or solely on race) risk excluding or under-protecting those whose experiences do not fit neatly within one category."]},"notation":["6.3.6"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/discrimination","prefLabel":{"en":"discrimination"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectionality","prefLabel":{"en":"intersectionality"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/gender-inequality","prefLabel":{"en":"gender inequality"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectionality--education","prefLabel":{"en":"intersectionality (education)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/multiple-discrimination","prefLabel":{"en":"multiple discrimination"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/structural-intersectionality","prefLabel":{"en":"structural intersectionality"}},{"id":"https://m-lancini.github.io/frida-vocab/dict