{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/inclusion--law.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/inclusion--law","type":"Concept","prefLabel":{"en":"inclusion (law)"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"Inclusion is the legal obligation to provide equal access, eliminate discrimination, and ensure it involves actively removing barriers, promoting equity, and fostering a sense of belonging across all areas of life, including the workplace, education, and family settings and refers to a comprehensive social and organizational approach."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["In the UN Convention on the Rights of Persons with Disabilities, inclusion is both a general principle (art. 3) and a specific right applicable to various areas (e.g. daily life, art. 19; education, art. 24; employment, art. 27; society and culture, arts. 29–30)."]},"notation":["3.6"],"example":null,"narrower":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/social-inclusion","prefLabel":{"en":"social inclusion"}}],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-3","prefLabel":{"en":"Culture, migration, poverty, and society"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/accessibility","prefLabel":{"en":"accessibility"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/equality","prefLabel":{"en":"equality"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/inclusion--employment","prefLabel":{"en":"inclusion (employment)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/inclusion--education","prefLabel":{"en":"inclusion (education)"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary