{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/gender-inequality.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/gender-inequality","type":"Concept","prefLabel":{"en":"gender inequality"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"The socially produced and maintained differentiation of rights, resources, opportunities, power, safety, and recognition based on gender and the social norms and roles associated with it."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["This inequality does not result from gender difference itself, but from institutional and cultural mechanisms that assign women and men different social positions and degrees of agency. In the case of girls and women with disabilities, it has an intersectional character: gender and disability may reinforce one another, creating specific forms of exclusion and discrimination. Gender inequality can be analysed through differences in access to education, employment, income, healthcare and reproductive rights, participation in decision-making, safety, autonomy, support and services, as well as through experiences of stereotyping, violence, and discrimination."]},"notation":["7.4.2"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/gender","prefLabel":{"en":"gender"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/coeducation","prefLabel":{"en":"coeducation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/male-dominance","prefLabel":{"en":"male dominance"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/patriarchy","prefLabel":{"en":"patriarchy"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/gender-based-violence","prefLabel":{"en":"gender-based violence"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/feminisation-of-poverty","prefLabel":{"en":"feminisation of poverty"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectional-discrimination","prefLabel":{"en":"intersectional discrimination"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/gender-gap","prefLabel":{"en":"gender gap"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/gender-role","prefLabel":{"en":"gender role"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/glass-ceiling","prefLabel":{"en":"glass ceiling"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/","title":{"en":"FRIDA Common Dictionary"}}],"inSchemeAll":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://m-lancini.github.io/frida-vocab/"}},"staticQueryHashes":["1805648281","3649515864","63159454"],"slicesMap":{}}