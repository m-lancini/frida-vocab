{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/care-work.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/care-work","type":"Concept","prefLabel":{"en":"care work"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"paid or unpaid activities involved in meeting the physical, emotional, relational, and practical needs of other persons."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["It includes direct forms of care, such as assisting children, older persons, persons with disabilities, or persons who are ill, as well as the domestic and organisational activities that make care possible. Care work is essential to individual well-being and to the everyday reproduction of households, communities, and society. Because care responsibilities are unequally distributed and often assigned to women, they may contribute to inequalities in income, employment, education, leisure, and participation."]},"notation":["14.9.1"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/work","prefLabel":{"en":"work"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/care","prefLabel":{"en":"care"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/motherhood","prefLabel":{"en":"motherhood"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/reproductive-labour","prefLabel":{"en":"reproductive labour"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/caregiver","prefLabel":{"en":"caregiver"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/unpaid-work","prefLabel":{"en":"unpaid work"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/paid-work","prefLabel":{"en":"paid work"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.gith