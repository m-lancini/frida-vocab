{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/segregation.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/segregation","type":"Concept","prefLabel":{"en":"segregation"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"A condition characterised by an unequal distribution of resources, services, and opportunities available to different social groups, based on several and possibly intersecting axes of discrimination, such as disability, gender, race, social and economic status, and so on."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["Segregation may also take spatial forms, when a social group is forced to occupy urban spaces separated from those inhabited by other groups, primarily on the basis of their origin (ethnic background) and social (class) and/or economic status. Segregation is determined — or at least conditioned — by historical and economic processes that intersect with urban, mobility, and welfare policies."]},"notation":["6.9"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-6","prefLabel":{"en":"Equality, discrimination and stereotyping"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/institutionalisation","prefLabel":{"en":"institutionalisation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/spatial-justice","prefLabel":{"en":"spatial justice"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/territorial-stigmatisation","prefLabel":{"en":"territorial stigmatisation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/differentialism","prefLabel":{"en":"differentialism"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/structural-discrimination","prefLabel":{"en":"structural discrimination"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/","title":{"en":"FRIDA Common Dictionary"}}],"inSchemeAll":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://m-lancini.github.io/frida-vocab/"}},"staticQueryHashes":["1805648281","3649515864","63159454"],"slicesMap":{}}