{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/unpaid-work.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/unpaid-work","type":"Concept","prefLabel":{"en":"unpaid work"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"Work that sustains persons, households, communities, and society, and is performed without direct monetary remuneration"},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["It includes domestic work, care work, subsistence activities, family work, volunteering, and community support. Although it produces substantial social and economic value, it is frequently excluded or undervalued in labour statistics, systems of social protection, and conventional measures of economic production. Its unequal distribution, particularly along gendered lines, may restrict access to income, education, leisure, public participation, and paid employment."]},"notation":["14.9.3"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/work","prefLabel":{"en":"work"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/care","prefLabel":{"en":"care"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/reproductive-labour","prefLabel":{"en":"reproductive labour"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/caregiver","prefLabel":{"en":"caregiver"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/feminisation-of-poverty","prefLabel":{"en":"feminisation of poverty"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/care-work","prefLabel":{"en":"care work"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/paid-work","prefLabel":{"en":"paid work"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-voc