{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/intersectionality.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectionality","type":"Concept","prefLabel":{"en":"intersectionality"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"An analytical framework that examines how multiple systems of oppression (such as racism, sexism, classism, ageism, and ableism) overlap and operate together, producing specific forms of disadvantage and exclusion that cannot be understood as the simple sum of different axes of discrimination, but rather as the result of the interaction between them"},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["The term was coined by American legal scholar and civil rights activist Kimberlé Williams Crenshaw to critique the single-axis approach traditionally adopted by U.S. courts. and demonstrate that traditional anti-discrimination frameworks often fail to capture the experiences of individuals situated at the intersection of multiple identities."]},"notation":["6.6"],"example":null,"narrower":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/structural-intersectionality","prefLabel":{"en":"structural intersectionality"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/political-intersectionality","prefLabel":{"en":"political intersectionality"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/representational-intersectionality","prefLabel":{"en":"representational intersectionality"}}],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-6","prefLabel":{"en":"Equality, discrimination and stereotyping"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/minoritised-groups","prefLabel":{"en":"minoritised groups"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/difference-sensitive-pedagogy","prefLabel":{"en":"difference-sensitive pedagogy"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/racism-and-racialisation","prefLabel":{"en":"racism and racialisation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/woman","prefLabel":{"en":"woman"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/situated-knowledge","prefLabel":{"en":"situated knowledge"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/cultural-identity","prefLabel":{"en":"cultural identity"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectionality--education","prefLabel":{"en":"intersectionality (education)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectional-discrimination","prefLabel":{"en":"intersectional discrimination"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/multiple-discrimination","prefLabel":{"en":"multiple discrimination"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectional-stereotype","prefLabel":{"en":"intersectional stereotype"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/situational-vulnerability","prefLabel":{"en":"situational vulnerability"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/gender-gap","prefLabel":{"en":"gender gap"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/","title":{"en":"FRIDA Common Dictionary"}}],"inSchemeAll":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/"}],"topConceptOf":[],"deprecated":null,"isReplacedBy":null},"collections":[],"customDomain":"https://m-lancini.github.io/frida-vocab/"}},"staticQueryHashes":["1805648281","3649515864","63159454"],"slicesMap":{}}