{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/inclusion--employment.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/inclusion--employment","type":"Concept","prefLabel":{"en":"inclusion (employment)"},"altLabel":{"en":["labour inclusion"]},"hiddenLabel":null,"definition":{"en":"Labour inclusion refers to equal treatment in the workplace, both when accessing a job and in the subsequent development of a professional career."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["This treatment ensures that people in vulnerable conditions – regardless of their ethnic origin, gender, sexual orientation, or any other circumstance – have the same opportunities to access dignified employment. Labor inclusion is based on the premise that the only requirement an individual should meet to obtain a job is their qualification and ability to perform it, without considering anything else."]},"notation":["14.5"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-14","prefLabel":{"en":"Work, employment and social protection"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/inclusion--law","prefLabel":{"en":"inclusion (law)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/reasonable-accommodation-in-employment--employment-law","prefLabel":{"en":"reasonable accommodation in employment (employment law)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/decent-work","prefLabel":{"en":"decent work"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/structural-integration","prefLabel":{"en":"structural integration"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/employability","prefLabel":{"en":"employability"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/employment-displacement","prefLabel"