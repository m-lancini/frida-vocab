{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/free-and-informed-consent.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/free-and-informed-consent","type":"Concept","prefLabel":{"en":"free and informed consent"},"altLabel":{"en":["consent"]},"hiddenLabel":null,"definition":{"en":"A person's voluntary acceptance of a medical, care-related or research intervention, on the basis of sufficient, understandable and accessible information – nature, risks, benefits and alternatives – and free from coercion, deception or undue influence; it also includes the right to refuse or withdraw it."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["The CRPD requires it in health care (art. 25), prohibits medical or scientific experiments without free consent (art. 15) and protects personal integrity (art. 17). In relation to legal capacity (art. 12), General Comment No. 1 (2014) rejects substitute decision-making and calls for support so that the decision expresses the person's will and preferences. It is the guarantee that distinguishes legitimate intervention from practices such as forced sterilisation or forced treatment."]},"notation":["8.3"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":null,"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/coercion-in-mental-health-care","prefLabel":{"en":"coercion in mental health care"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/legal-capacity","prefLabel":{"en":"legal capacity"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/accessible-comprehensive-sexuality-education","prefLabel":{"en":"accessible comprehensive sexuality education"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/contraception","prefLabel":{"en":"contraception"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/forced-sterilisation","prefLabel