{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/reproductive-labour.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/reproductive-labour","type":"Concept","prefLabel":{"en":"reproductive labour"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"Paid or unpaid work required to sustain persons, households, communities, and the labour force, such as care, domestic work, child-rearing, and emotional support."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["Productive and reproductive labour are distinct but interdependent forms of work.The distinction is neither natural nor neutral. Historically, economic and legal frameworks have treated remunerated market activity as productive while excluding or undervaluing domestic and care work, disproportionately performed by women. This reflects patriarchal divisions of labour that have represented reproductive work as a private duty or a natural female role rather than as socially necessary labour."]},"notation":["14.7"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-14","prefLabel":{"en":"Work, employment and social protection"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/productive-labour","prefLabel":{"en":"productive labour"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/unpaid-work","prefLabel":{"en":"unpaid work"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/gender-role","prefLabel":{"en":"gender role"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/care-work","prefLabel":{"en":"care work"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/","title":{"en":"FRIDA Common Dictionary"}}],"inSchemeAll":[{"id":"https: