{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/situated-knowledge.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/situated-knowledge","type":"Concept","prefLabel":{"en":"situated knowledge"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"Knowledge produced from a particular social, historical, embodied, and institutional position."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["The concept of situated knowledge rejects the idea of a fully neutral or disembodied standpoint and requires attention to how the position of the knower shapes what can be perceived, understood, and represented. Situatedness does not imply that all claims are equally valid, but that knowledge claims should be assessed with awareness of their conditions, limits, and relations of power."]},"notation":["9.4"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-9","prefLabel":{"en":"Research methodology"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/paradigmatic-subject","prefLabel":{"en":"paradigmatic subject"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/intersectionality","prefLabel":{"en":"intersectionality"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/credibility--qualitative-research","prefLabel":{"en":"credibility (qualitative research)"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/heterodox-perspective-methodology","prefLabel":{"en":"heterodox perspective/methodology"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/","title":{"en":"FRIDA Common Dictionary"}}],"inSchemeAll":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/"}],"topConceptOf":[],"deprecated":null,"