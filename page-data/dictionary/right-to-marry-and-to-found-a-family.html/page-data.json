{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/right-to-marry-and-to-found-a-family.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/right-to-marry-and-to-found-a-family","type":"Concept","prefLabel":{"en":"right to marry and to found a family"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"The right of every person of marriageable age to marry and form a family with free and full consent, and to decide on having children."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["Disability cannot restrict this right: persons with disabilities have the right to marry and to found a family, to decide freely on the number and spacing of their children, to retain their fertility and not to be separated from their children on the ground of disability. Marriage equality is not a uniform European standard but an option of national law; that said, States must provide some form of legal recognition and protection for same-sex couples."]},"notation":["2.7"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-2","prefLabel":{"en":"Children, family and parental responsibility"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/family","prefLabel":{"en":"family"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/parental-responsibility","prefLabel":{"en":"parental responsibility"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/motherhood","prefLabel":{"en":"motherhood"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/forced-sterilisation","prefLabel":{"en":"forced sterilisation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/reproductive-rights","prefLabel":{"en":"reproductive rights"}}],"relatedMatch":null,"broadMatch":null,"narrowMatch":null,"closeMatch":null,"exactMatch":null,"inScheme":