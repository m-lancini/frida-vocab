{"componentChunkName":"component---src-components-concept-jsx","path":"/dictionary/deinstitutionalisation.html","result":{"pageContext":{"node":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/deinstitutionalisation","type":"Concept","prefLabel":{"en":"deinstitutionalisation"},"altLabel":null,"hiddenLabel":null,"definition":{"en":"The transition from institutional care to community-based services and independent living, with appropriate support, autonomy, and social inclusion."},"note":null,"changeNote":null,"editorialNote":null,"historyNote":null,"scopeNote":{"en":["It is not limited to moving people out of facilities: it entails transforming the system to prevent new admissions, restoring legal capacity, guaranteeing housing, personal assistance and access to mainstream services, and providing redress to those who suffered institutionalisation. The CRPD derives it from art. 19, and in 2022 the Committee adopted Guidelines on deinstitutionalisation, including in emergencies. It specifically affects women and children with disabilities."]},"notation":["1.4"],"example":null,"narrower":[],"narrowerTransitive":[],"broader":{"id":"https://m-lancini.github.io/frida-vocab/dictionary/section-1","prefLabel":{"en":"Autonomy, participation, care and support"}},"broaderTransitive":null,"related":[{"id":"https://m-lancini.github.io/frida-vocab/dictionary/independent-living-and-inclusion-in-the-community","prefLabel":{"en":"independent living and inclusion in the community"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/institutionalisation","prefLabel":{"en":"institutionalisation"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/alternative-care","prefLabel":{"en":"alternative care"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/children-with-disabilities","prefLabel":{"en":"children with disabilities"}},{"id":"https://m-lancini.github.io/frida-vocab/dictionary/situations-of-risk","prefLabel":{"en":"situations of risk"}}],"relatedMa