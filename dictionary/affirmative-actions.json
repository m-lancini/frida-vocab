{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/affirmative-actions",
  "type": "Concept",
  "prefLabel": {
    "en": "affirmative actions"
  },
  "definition": {
    "en": "Specific, targeted, and temporary measures adopted by public authorities or private actors, aimed at preventing, reducing, or compensating disadvantages affecting certain protected groups identified on prohibited grounds of discrimination (racial or ethnic origin; religion or belief; disability; age; sexual orientation; sex, gender in order to ensure substantive and effective equality, rather than merely formal equality."
  },
  "scopeNote": {
    "en": [
      "It constitutes a lawful derogation from the principle of equal treatment, insofar as it allows differential treatment justified by the need to correct factual inequalities, provided that it complies with the principles of proportionality, reasonableness, and temporariness. In the UN Convention on the Rights of Persons with Disabilities, the right to benefit from affirmative action is set out in Article 5."
    ]
  },
  "notation": [
    "6.1"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-6",
    "prefLabel": {
      "en": "Equality, discrimination and stereotyping"
    }
  },
