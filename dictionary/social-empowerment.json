{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/social-empowerment",
  "type": "Concept",
  "prefLabel": {
    "en": "social empowerment"
  },
  "definition": {
    "en": "The process through which individuals and groups develop the skills, capabilities, and autonomy necessary to make decisions that challenge and reduce social inequalities."
  },
  "scopeNote": {
    "en": [
      "It involves fostering the autonomy of marginalised populations, allowing them to actively participate in shaping their own lives and communities."
    ]
  },
  "notation": [
    "1.5.2"
  ],
