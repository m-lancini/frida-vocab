{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/best-interests-of-the-child",
  "type": "Concept",
  "prefLabel": {
    "en": "best interests of the child"
  },
  "definition": {
    "en": "A requirement that, in any decision affecting a child or adolescent, their best interests be assessed and weighed as a primary consideration."
  },
  "scopeNote": {
    "en": [
      "It does not operate as a rule of automatic precedence, but as a criterion to be determined case by case, in the light of each child's circumstances and oriented towards the effective enjoyment of their rights; hence its threefold nature as a substantive right, an interpretative principle and a rule of procedure. Where children with disabilities are concerned, this determination must be made on a basis of equality and non-discrimination, with respect for the evolving capacities of the child and for their identity, and ensuring that they can express their views with appropriate support and the accessibility needed for effective participation."
    ]
  },
  "notation": [
    "2.2"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-2",
    "prefLabel": {
      "en": "Children, family and parental responsibility"
    }
  },
