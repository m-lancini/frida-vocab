{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/paid-work",
  "type": "Concept",
  "prefLabel": {
    "en": "paid work"
  },
  "definition": {
    "en": "Work performed in exchange for wages, salaries, fees, income, or other forms of monetary remuneration."
  },
  "scopeNote": {
    "en": [
      "It may take place within formal or informal labour markets and includes employment, self-employment, freelance work, entrepreneurship, and other income-generating activities. Paid work may provide access to income, social protection, professional recognition, and labour rights, although these benefits depend on working conditions, remuneration, legal status, and the availability of institutional protections."
    ]
  },
  "notation": [
    "14.9.2"
  ],
