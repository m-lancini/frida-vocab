{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/barrier-in-education--education",
  "type": "Concept",
  "prefLabel": {
    "en": "barrier in education (education)"
  },
  "definition": {
    "en": "Conditions within the educational environment that hinder or limit everyone’s ability to access, participate, learn and develop on an equal footing, regardless of their characteristics, needs or circumstances."
  },
  "scopeNote": {
    "en": [
      "Generally speaking, these include attitudinal barriers linked to stereotypes, discrimination or low expectations; institutional barriers arising from educational policies that lack inclusivity, a lack of resources, or poor coordination and organisation of support services; curricular barriers, linked to inflexible teaching methods or rigid assessment practices; and barriers relating to accessibility and participation."
    ]
  },
  "notation": [
    "4.4.2"
  ],
  "related": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/universal-design-for-learning",
      "prefLabel": {
        "en": "universal design for learning"
      }
    },
