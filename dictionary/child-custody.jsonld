{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/child-custody",
  "type": "Concept",
  "prefLabel": {
    "en": "child custody"
  },
  "definition": {
    "en": "The habitual living arrangement with the child and their day-to-day care."
  },
  "scopeNote": {
    "en": [
      "Both its allocation – sole or joint – and the regime of contact with the other parent are decided in accordance with the child's best interests. The existence of violence must weigh in that decision, and the disability of a parent or of the child cannot, in itself, be a ground for denying custody or justifying separation; parents with disabilities must be provided with appropriate assistance to exercise it."
    ]
  },
  "notation": [
    "2.5.1"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/parental-responsibility",
    "prefLabel": {
      "en": "parental responsibility"
    }
  },
  "related": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/best-interests-of-the-child",
