{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/humanrobot-interaction--robotics",
  "type": "Concept",
  "prefLabel": {
    "en": "human–robot interaction (robotics)"
  },
  "definition": {
    "en": "A multidisciplinary field that studies the exchanges between people and robots, encompassing physical interaction, safety protocols, and psychological factors such as trust, engagement, and the perception of the robot by the human user."
  },
  "scopeNote": {
    "en": [
      "It can be differentiated into Physical HRI if the interaction is based on a force exchange between a robot and a human (worn exoskeleton, assistive pedals…) or Cognitive HRI (perception of the robot by the human or of the human by the robot)."
    ]
  },
  "notation": [
    "12.4"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-12",
    "prefLabel": {
      "en": "Technology and robotics"
    }
  },
  "related": [
