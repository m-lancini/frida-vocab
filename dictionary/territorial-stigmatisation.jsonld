{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/territorial-stigmatisation",
  "type": "Concept",
  "prefLabel": {
    "en": "territorial stigmatisation"
  },
  "definition": {
    "en": "The process through which negative narratives associated with a place are transferred onto the people who live there, producing exclusion and marginalisation."
  },
  "scopeNote": {
    "en": [
      "It is produced through the stratification of ethnic and class discrimination, control policies, media processes, and urban and social policies."
    ]
  },
  "notation": [
    "3.20"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-3",
    "prefLabel": {
      "en": "Culture, migration, poverty, and society"
    }
  },
