{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/victim",
  "type": "Concept",
  "prefLabel": {
    "en": "victim"
  },
  "definition": {
    "en": "A person who, individually or collectively, has suffered harm – physical, psychological, emotional or economic, or an impairment of their fundamental rights – as a result of a crime or an abuse of power, regardless of whether the perpetrator is identified or convicted."
  },
  "scopeNote": {
    "en": [
      "Victim status entails rights: to information, protection, support, participation in proceedings and reparation, as well as to be free from revictimisation or secondary victimisation, i.e. the additional harm caused by the system itself. In gender-based violence it also covers indirect victims, such as the children. Victims with disabilities require procedural accommodations and accessibility to exercise those rights on an equal basis."
    ]
  },
  "notation": [
    "10.10"
  ],
  "narrower": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/revictimisation",
      "prefLabel": {
        "en": "revictimisation"
      }
    }
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-10",
    "prefLabel": {
      "en": "Rights, legal capacity and access to justice"
    }
  },
  "related": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/access-to-justice",
      "prefLabel": {
        "en": "access to justice"
      }
