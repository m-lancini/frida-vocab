{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/inclusive-research",
  "type": "Concept",
  "prefLabel": {
    "en": "inclusive research"
  },
  "definition": {
    "en": "A specific form of participatory research characterised by the substantive involvement of people with intellectual disabilities in defining, conducting and using research"
  },
  "scopeNote": {
    "en": [
      "The mere participation of these individuals in a study does not automatically make participatory research inclusive. Inclusive research requires researchers and other stakeholders to be willing to listen to, learn from, and share knowledge with the people with intellectual disabilities involved. Research may be considered inclusive when: (1) those involved influence the research agenda; (2) they participate in decision-making throughout the research process; (3) they contribute to the production and interpretation of data; (4) they benefit in some way from the research; and (5) they are recognised as legitimate producers of knowledge. The core of inclusive research does not lie in the use of a particular technique or methodology, but rather in the democratisation of the knowledge and power relations that shape the research process."
    ]
  },
  "notation": [
    "9.3"
  ],
  "narrower": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/participatory-research",
