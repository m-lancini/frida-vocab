{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/family-mediation",
  "type": "Concept",
  "prefLabel": {
    "en": "family mediation"
  },
  "definition": {
    "en": "The application of mediation to family disputes: an impartial third party, with no decision-making power, helps family members to reach agreements by themselves on their crisis or reorganisation."
  },
  "scopeNote": {
    "en": [
      "Where children or adolescents are involved, the outcome must be governed by their best interests and must respect their right to be heard. The requirements of accessibility, accommodation and support apply to it, as does the limit on mandatory mediation in contexts of violence."
    ]
  },
  "notation": [
    "10.5.1"
  ],
