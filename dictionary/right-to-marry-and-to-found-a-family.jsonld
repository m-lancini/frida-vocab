{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/right-to-marry-and-to-found-a-family",
  "type": "Concept",
  "prefLabel": {
    "en": "right to marry and to found a family"
  },
  "definition": {
    "en": "The right of every person of marriageable age to marry and form a family with free and full consent, and to decide on having children."
  },
  "scopeNote": {
    "en": [
      "Disability cannot restrict this right: persons with disabilities have the right to marry and to found a family, to decide freely on the number and spacing of their children, to retain their fertility and not to be separated from their children on the ground of disability. Marriage equality is not a uniform European standard but an option of national law; that said, States must provide some form of legal recognition and protection for same-sex couples."
    ]
  },
  "notation": [
    "2.7"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-2",
    "prefLabel": {
      "en": "Children, family and parental responsibility"
    }
  },
