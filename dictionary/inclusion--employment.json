{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/inclusion--employment",
  "type": "Concept",
  "prefLabel": {
    "en": "inclusion (employment)"
  },
  "altLabel": {
    "en": [
      "labour inclusion"
    ]
  },
  "definition": {
    "en": "Labour inclusion refers to equal treatment in the workplace, both when accessing a job and in the subsequent development of a professional career."
  },
  "scopeNote": {
    "en": [
      "This treatment ensures that people in vulnerable conditions – regardless of their ethnic origin, gender, sexual orientation, or any other circumstance – have the same opportunities to access dignified employment. Labor inclusion is based on the premise that the only requirement an individual should meet to obtain a job is their qualification and ability to perform it, without considering anything else."
    ]
  },
  "notation": [
    "14.5"
  ],
