{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/independent-living-and-inclusion-in-the-community",
  "type": "Concept",
  "prefLabel": {
    "en": "independent living and inclusion in the community"
  },
  "definition": {
    "en": "The right of persons with disabilities to live independently and to be included in the community, choosing where, how and with whom to live on an equal basis, without being obliged to live in a particular arrangement."
  },
  "scopeNote": {
    "en": [
      "It does not mean living alone or coping without help: independence is exercised with the necessary supports, such as personal assistance or accessible community services. The CRPD recognises it in art. 19, developed by General Comment No. 5 (2017), which requires deinstitutionalisation and the provision of community-based services. It is the opposite of institutionalisation, which segregates and depersonalises."
    ]
  },
  "notation": [
    "1.7"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-1",
    "prefLabel": {
      "en": "Autonomy, participation, care and support"
    }
  },
