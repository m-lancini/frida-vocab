{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/support-in-decision-making",
  "type": "Concept",
  "prefLabel": {
    "en": "support in decision-making"
  },
  "definition": {
    "en": "The set of measures, relationships and forms of assistance that enables individuals to understand information, consider options, communicate preferences, and make decisions according to their own will and preferences. Decision-making support respects personal autonomy and recognises that all individuals have the right to direct their own lives."
  },
  "scopeNote": {
    "en": [
      "It may include support from trusted persons or support networks, assistance with communication, accessible information, interpretation, facilitation or advance planning. The CRPD (art. 12), as developed by General Comment No. 1 (2014), requires replacing substitute decision-making with a support model guided by the person's will and preferences, proportionate to their circumstances and accompanied by safeguards against abuse, conflict of interest and undue influence."
    ]
  },
  "notation": [
    "1.13.5"
  ],
  "broader": {
