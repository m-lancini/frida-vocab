{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/homelessness",
  "type": "Concept",
  "prefLabel": {
    "en": "homelessness"
  },
  "definition": {
    "en": "A relatively permanent, involuntary life situation in which an individual or family is left homeless or unable to provide, through their efforts, the minimal shelter they could consider their own home."
  },
  "scopeNote": {
    "en": [
      "In the literature, homelessness signifies the simultaneous severing of social ties, loss of roots, and the destruction of personal identity, caused by a combination of structural (economic) and individual (biographical) factors."
    ]
  },
  "notation": [
    "3.5"
  ],
  "narrower": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/homeless-woman",
      "prefLabel": {
        "en": "homeless woman"
      }
    }
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-3",
    "prefLabel": {
      "en": "Culture, migration, poverty, and society"
    }
  },
  "related": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/poverty",
      "prefLabel": {
        "en": "poverty"
      }
    },
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/precarity",
      "prefLabel": {
        "en": "precarity"
      }
    }
  ],
