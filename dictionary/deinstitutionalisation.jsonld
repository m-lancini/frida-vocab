{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/deinstitutionalisation",
  "type": "Concept",
  "prefLabel": {
    "en": "deinstitutionalisation"
  },
  "definition": {
    "en": "The transition from institutional care to community-based services and independent living, with appropriate support, autonomy, and social inclusion."
  },
  "scopeNote": {
    "en": [
      "It is not limited to moving people out of facilities: it entails transforming the system to prevent new admissions, restoring legal capacity, guaranteeing housing, personal assistance and access to mainstream services, and providing redress to those who suffered institutionalisation. The CRPD derives it from art. 19, and in 2022 the Committee adopted Guidelines on deinstitutionalisation, including in emergencies. It specifically affects women and children with disabilities."
    ]
  },
  "notation": [
    "1.4"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-1",
    "prefLabel": {
      "en": "Autonomy, participation, care and support"
    }
  },
  "related": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/independent-living-and-inclusion-in-the-community",
