{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/sex-assistant",
  "type": "Concept",
  "prefLabel": {
    "en": "sex assistant"
  },
  "definition": {
    "en": "A specialised practitioner who assists people with disabilities in accessing their right to sexual health."
  },
  "scopeNote": {
    "en": [
      "This specifically trained professional facilitates sexual expression, body exploration, and physical pleasure for individuals or couples who face physical, cognitive, or psychological barriers to experiencing their own sexuality, helping to fulfil their intimate and affective needs, while reinforcing the sexual autonomy, self-knowledge and emotional safety."
    ]
  },
  "notation": [
    "11.7.1"
  ],
