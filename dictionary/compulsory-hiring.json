{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/compulsory-hiring",
  "type": "Concept",
  "prefLabel": {
    "en": "compulsory hiring"
  },
  "definition": {
    "en": "A set of statutory obligations imposed on employers requiring them to recruit and employ a minimum quota of individuals belonging to designated protected or disadvantaged groups."
  },
  "scopeNote": {
    "en": [
      "These obligations are typically grounded in labour and anti-discrimination law and are designed to promote substantive equality by addressing structural disadvantages in access to the labour market. Compulsory hiring schemes usually operate through quota-based mechanisms. From a legal perspective, compulsory hiring represents a form of affirmative action justified as an exception to the principle of formal equality in order to achieve effective equality in practice. Within the European legal framework, such measures are considered compatible with the principle of equal treatment. as articulated in Directive 2000/78/EC."
    ]
  },
  "notation": [
    "14.1"
  ],
