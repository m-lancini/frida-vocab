{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/impairment",
  "type": "Concept",
  "prefLabel": {
    "en": "impairment"
  },
  "definition": {
    "en": "A loss or limitation of physical, mental, sensory, or cognitive function that affects a person’s body or mind, forming one component of disability when interacting with social and environmental barriers."
  },
  "scopeNote": {
    "en": [
      "Impairment concerns an organism (its functioning and structure) that, as a result of damage, does not function properly. Impaired is defined as any abnormality or loss of ability in the structure or functioning of an organism in psychological, psychophysical, or anatomical terms. It is a condition understood in biomedical terms that relates directly to the structure of an organism that, as a result of a defect or injury, does not function properly. It is usually certified by medical experts and medical services."
    ]
  },
  "notation": [
    "4.6"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-4",
    "prefLabel": {
      "en": "Disability, impairment and accessibility"
    }
  },
  "related": [
    {
