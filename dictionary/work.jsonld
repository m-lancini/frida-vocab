{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/work",
  "type": "Concept",
  "prefLabel": {
    "en": "work"
  },
  "definition": {
    "en": "The broad range of activities through which persons produce goods and services, provide care, sustain households and communities, develop capacities and identities, and participate in economic and social life."
  },
  "scopeNote": {
    "en": [
      "Work may be paid or unpaid and may take place in formal or informal, public, private, household, community, or voluntary settings. The concept therefore extends beyond employment and market-oriented activity to include forms of domestic, caring, subsistence, creative, and community work that are socially necessary but often insufficiently recognised or valued."
    ]
  },
  "notation": [
    "14.9"
  ],
  "narrower": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/unpaid-work",
      "prefLabel": {
        "en": "unpaid work"
      }
    },
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/care-work",
      "prefLabel": {
        "en": "care work"
      }
    },
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/paid-work",
      "prefLabel": {
        "en": "paid work"
      }
    }
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-14",
    "prefLabel": {
      "en": "Work, employment and social protection"
    }
  },
