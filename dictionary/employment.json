{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/employment",
  "type": "Concept",
  "prefLabel": {
    "en": "employment"
  },
  "definition": {
    "en": "A specific form of paid work carried out within an employment relationship, generally governed by labour law, contractual arrangements, and social protection systems."
  },
  "scopeNote": {
    "en": [
      "Employment may be full-time, part-time, temporary, permanent, or flexible and constitutes one of several possible forms of participation in economic life."
    ]
  },
