{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/interdependence",
  "type": "Concept",
  "prefLabel": {
    "en": "interdependence"
  },
  "definition": {
    "en": "The condition in which subjects are mutually constituted and sustained through networks of social, material, and institutional relations."
  },
  "scopeNote": {
    "en": [
      "Rather than undermining agency, interdependence is the condition that enables it: individuals act and orient their lives through relationships with others, environments, infrastructures, and norms that both constrain and support their capacity to act."
    ]
  },
  "notation": [
    "1.10"
  ],
  "broader": {
