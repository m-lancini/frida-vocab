{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/woman",
  "type": "Concept",
  "prefLabel": {
    "en": "woman"
  },
  "definition": {
    "en": "For the purposes of this dictionary, the term includes both cisgender women - persons assigned female at birth whose gender identity is female - and transgender women (persons whose gender identity is female and does not correspond to the sex assigned at birth). This inclusive use does not make sex, legal sex and gender identity interchangeable."
  },
  "scopeNote": {
    "en": [
      "Women do not constitute a homogeneous group: their experiences, opportunities and exposure to discrimination may vary according to disability, age, racialisation, ethnic or cultural minority status, religion, migration status, socio-economic position and other intersecting factors"
    ]
  },
  "notation": [
    "7.12"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-7",
    "prefLabel": {
      "en": "Gender, sex and sexuality"
    }
  },
