{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/poverty",
  "type": "Concept",
  "prefLabel": {
    "en": "poverty"
  },
  "definition": {
    "en": "A condition in which people lack the resources and real opportunities needed to meet basic needs, enjoy an adequate standard of living, and participate in society."
  },
  "scopeNote": {
    "en": [
      "An intersectional reading treats poverty not as an individual attribute but as an effect of interlocking structures of gender, disability, racialisation, migration status and class. These axes do not simply add up; they produce qualitatively distinct positions that single-axis statistics render invisible. EU data show elevated risk for women (21.9% vs. 19.8% for men), persons with disabilities (28.8%) and non-EU citizens (43.8%). Consequences extend beyond material scarcity to restricted capabilities (Sen, 1999), health inequalities, educational exclusion and intergenerational transmission. Anti-poverty policy must therefore be difference-sensitive rather than compensating isolated characteristics."
    ]
  },
  "notation": [
    "3.12"
  ],
  "narrower": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/feminisation-of-poverty",
      "prefLabel": {
        "en": "feminisation of poverty"
      }
    }
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-3",
    "prefLabel": {
      "en": "Culture, migration, poverty, and society"
    }
  },
