{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/equality",
  "type": "Concept",
  "prefLabel": {
    "en": "equality"
  },
  "definition": {
    "en": "The principle and practice of ensuring that all people have the same dignity, rights, value, and opportunities, regardless of gender, sex, sexuality, race, class, disability, ethnicity, religion, age, or other aspects of identity."
  },
  "scopeNote": {
    "en": [
      "Equality does not simply mean treating everyone in the same way (formal equality) but recognising historical and structural injustices and working to remove the barriers that prevent full participation, safety, and self-determination for marginalised people (substantive equality)."
    ]
  },
  "notation": [
    "6.4"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-6",
    "prefLabel": {
      "en": "Equality, discrimination and stereotyping"
    }
  },
