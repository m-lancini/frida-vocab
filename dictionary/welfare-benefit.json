{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/welfare-benefit",
  "type": "Concept",
  "prefLabel": {
    "en": "welfare benefit"
  },
  "definition": {
    "en": "Public or social security benefits and social assistance measures granted under national and EU law to protect individuals against social risks – such as unemployment, illness, disability, family responsibilities, or old age – and to promote social inclusion and a decent standard of living."
  },
  "scopeNote": {
    "en": [
      "Under EU law, these benefits form part of the broader concept of social security and social assistance recognised by Article 34 of the Charter of Fundamental Rights of the European Union1, which entitles legally resident persons to social security benefits and social advantages in accordance with Union and national legislation. Access to these benefits must respect the principle of equal treatment and must not be restricted on discriminatory grounds, including nationality and residence status, unless justified under EU law."
    ]
  },
  "notation": [
    "14.8"
  ],
  "broader": {
