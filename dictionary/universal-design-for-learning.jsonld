{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/universal-design-for-learning",
  "type": "Concept",
  "prefLabel": {
    "en": "universal design for learning"
  },
  "definition": {
    "en": "A model that aims to reshape education by providing a conceptual framework that facilitates the analysis and evaluation of curriculum designs and educational practices, in order to identify barriers to learning and promote inclusive teaching approaches."
  },
  "scopeNote": {
    "en": [
      "It sets out a framework for developing flexible curricular proposals (objectives, assessment, methodologies and resources) that respond to the diverse needs and abilities of pupils. Recognising the variability among individuals requires teaching approaches that are designed with the full range of differences in mind, using flexible curricular and organisational approaches. Universal Design for Learning is based on three principles: (1) providing multiple ways of engagement, (2) providing multiple forms of representation, and (3) providing multiple forms of action and expression."
    ]
  },
  "notation": [
    "4.12.1"
  ],
  "related": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/barrier-in-education--education",
      "prefLabel": {
        "en": "barrier in education (education)"
      }
    },
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/inclusive-education",
      "prefLabel": {
        "en": "inclusive education"
      }
    },
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/personalisation--education",
      "prefLabel": {
        "en": "personalisation (education)"
      }
    }
  ],
