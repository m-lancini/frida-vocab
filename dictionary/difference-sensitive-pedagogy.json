{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/difference-sensitive-pedagogy",
  "type": "Concept",
  "prefLabel": {
    "en": "difference-sensitive pedagogy"
  },
  "definition": {
    "en": "A pedagogical fundamental orientation and a professional stance promoting a reflective treatment of differences between learners that neither levels difference out (equal treatment as homogenisation) nor uses it for hierarchisation or stigmatisation."
  },
  "scopeNote": {
    "en": [
      "Difference is recognised as the normal case; the aim is equal worth in difference. The term functions as an umbrella concept spanning several sub-concepts that share this underlying norm but operate on distinct levels of reference, each carrying its own guiding question, understanding of difference, and relation to power."
    ]
  },
  "notation": [
    "5.2"
  ],
