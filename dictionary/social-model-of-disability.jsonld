{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/social-model-of-disability",
  "type": "Concept",
  "prefLabel": {
    "en": "social model of disability"
  },
  "definition": {
    "en": "A model of disability that conceives disability as the result of socially produced barriers and oppressive structures that restrict the rights, equality and full participation in society of persons with disabilities."
  },
  "scopeNote": {
    "en": [
      "Theorised by Mike Oliver in the 1990s and, somewhat later, by Thomas Shakespeare, who proposed a significant variant of it, it can today be regarded as an “umbrella” paradigm encompassing approaches that focus on the oppressive mechanisms through which disability is socially constructed. These approaches aim at the removal of environmental and cultural barriers that hinder the enjoyment of the rights to freedom and equality and, more generally, the full participation of persons with disabilities in society."
    ]
  },
  "notation": [
    "4.5.1.2"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/models-of-disability",
    "prefLabel": {
      "en": "models of disability"
    }
  },
