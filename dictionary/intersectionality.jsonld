{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/intersectionality",
  "type": "Concept",
  "prefLabel": {
    "en": "intersectionality"
  },
  "definition": {
    "en": "An analytical framework that examines how multiple systems of oppression (such as racism, sexism, classism, ageism, and ableism) overlap and operate together, producing specific forms of disadvantage and exclusion that cannot be understood as the simple sum of different axes of discrimination, but rather as the result of the interaction between them"
  },
  "scopeNote": {
    "en": [
      "The term was coined by American legal scholar and civil rights activist Kimberlé Williams Crenshaw to critique the single-axis approach traditionally adopted by U.S. courts. and demonstrate that traditional anti-discrimination frameworks often fail to capture the experiences of individuals situated at the intersection of multiple identities."
    ]
  },
  "notation": [
    "6.6"
  ],
