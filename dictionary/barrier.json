{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/barrier",
  "type": "Concept",
  "prefLabel": {
    "en": "barrier"
  },
  "definition": {
    "en": "Factors within physical, material, social, or symbolic environments that hinder participation on an equal basis with others."
  },
  "scopeNote": {
    "en": [
      "The CRPD, in its preamble, recognises that disability results from the interaction between persons with impairments and social barriers that hinder their full and effective participation in society on an equal basis with others."
    ]
  },
  "notation": [
    "4.4"
  ],
