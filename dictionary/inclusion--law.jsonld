{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/inclusion--law",
  "type": "Concept",
  "prefLabel": {
    "en": "inclusion (law)"
  },
  "definition": {
    "en": "Inclusion is the legal obligation to provide equal access, eliminate discrimination, and ensure it involves actively removing barriers, promoting equity, and fostering a sense of belonging across all areas of life, including the workplace, education, and family settings and refers to a comprehensive social and organizational approach."
  },
  "scopeNote": {
    "en": [
      "In the UN Convention on the Rights of Persons with Disabilities, inclusion is both a general principle (art. 3) and a specific right applicable to various areas (e.g. daily life, art. 19; education, art. 24; employment, art. 27; society and culture, arts. 29–30)."
    ]
  },
  "notation": [
    "3.6"
  ],
  "narrower": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/social-inclusion",
      "prefLabel": {
        "en": "social inclusion"
      }
    }
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-3",
    "prefLabel": {
      "en": "Culture, migration, poverty, and society"
    }
  },
