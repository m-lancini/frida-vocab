{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/hiring-quotas",
  "type": "Concept",
  "prefLabel": {
    "en": "hiring quotas"
  },
  "definition": {
    "en": "legally or institutionally established requirements that mandate employers to ensure that a specified proportion or number of their workforce is composed of individuals from particular groups, typically those who are underrepresented or disadvantaged in the labour market (such as persons with disabilities, ethnic minorities, or women)."
  },
  "scopeNote": {
    "en": [
      "In legal terms, hiring quotas are a form of affirmative action designed to achieve substantive equality (by correcting structural imbalances in employment. They operate by setting measurable targets. Within the European legal framework, hiring quotas are generally considered compatible with the principle of equal treatment where they pursue legitimate social aims and comply with proportionality requirements, as recognised under Directive 2000/78/EC."
    ]
  },
  "notation": [
    "14.1.1"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/compulsory-hiring",
    "prefLabel": {
      "en": "compulsory hiring"
    }
  },
  "related": [
    {
      "id": "https://m-lancini.github.io/frida-vocab/dictionary/affirmative-actions",
      "prefLabel": {
        "en": "affirmative actions"
      }
    },
