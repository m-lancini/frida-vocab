{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/support",
  "type": "Concept",
  "prefLabel": {
    "en": "support"
  },
  "definition": {
    "en": "The broad range of measures, relationships, resources, services, accommodations, and assistance that enable individuals to exercise their rights, make decisions, pursue their goals, participate in society, and live according to their own preferences and will."
  },
  "scopeNote": {
    "en": [
      "Support may be provided formally or informally and can vary in intensity, duration, and form according to individual circumstances and contexts It is based on the recognition that all human beings may require different forms of assistance throughout their lives and that the need for support should not diminish a person's autonomy, dignity, legal status, or right to self-determination."
    ]
  },
  "notation": [
    "1.13"
  ],
