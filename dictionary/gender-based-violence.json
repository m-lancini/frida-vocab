{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/gender-based-violence",
  "type": "Concept",
  "prefLabel": {
    "en": "gender-based violence"
  },
  "definition": {
    "en": "Any harmful act directed against a person because of their gender, gender identity, or gender expression, or which disproportionately affects people of a particular gender."
  },
  "scopeNote": {
    "en": [
      "It may take physical, sexual, psychological, economic, or digital forms and is rooted in unequal power relations and harmful gender norms. It can affect anyone but disproportionately impacts women and girls."
    ]
  },
  "notation": [
    "13.5"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-13",
