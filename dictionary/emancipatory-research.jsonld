{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/emancipatory-research",
  "type": "Concept",
  "prefLabel": {
    "en": "emancipatory research"
  },
  "definition": {
    "en": "Research that is controlled by those directly affected, with the aim of empowering them through both the research process and its outcomes."
  },
  "scopeNote": {
    "en": [
      "Emancipatory research is usually defined in political terms and has a stronger political orientation. It is described as a means of challenging social oppression. The oppression experienced by people with disabilities requires a transformation in the nature of research relationships. Researchers should place themselves at the service of people with disabilities. Furthermore, people with disabilities should have control over the resources involved in the research process, a key distinction between emancipatory and participatory research. The research process is therefore inherently politicised, since its purpose extends beyond knowledge production to the transformation of unequal social relations and the empowerment of disabled people."
    ]
  },
  "notation": [
    "9.3.1"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/inclusive-research",
    "prefLabel": {
      "en": "inclusive research"
    }
  },
