{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/gender-stereotypes",
  "type": "Concept",
  "prefLabel": {
    "en": "gender stereotypes"
  },
  "definition": {
    "en": "Preconception about the attributes, characteristics or roles that women and men should have or perform on the basis of their sex or gender."
  },
  "notation": [
    "6.10.1"
  ],
