{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/care-work",
  "type": "Concept",
  "prefLabel": {
    "en": "care work"
  },
  "definition": {
    "en": "paid or unpaid activities involved in meeting the physical, emotional, relational, and practical needs of other persons."
  },
  "scopeNote": {
    "en": [
      "It includes direct forms of care, such as assisting children, older persons, persons with disabilities, or persons who are ill, as well as the domestic and organisational activities that make care possible. Care work is essential to individual well-being and to the everyday reproduction of households, communities, and society. Because care responsibilities are unequally distributed and often assigned to women, they may contribute to inequalities in income, employment, education, leisure, and participation."
    ]
  },
  "notation": [
    "14.9.1"
  ],
