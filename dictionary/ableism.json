{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/ableism",
  "type": "Concept",
  "prefLabel": {
    "en": "ableism"
  },
  "definition": {
    "en": "Discrimination, prejudice, or bias against people with disabilities, based on the assumption that typical physical, neurocognitive, or sensory abilities are superior or more desirable."
  },
  "scopeNote": {
    "en": [
      "The term derives from able + -ism and began to emerge around the mid-1960s within social movements advocating for disability rights. It was later theorised and more systematically developed in the 1980s within the field of disability studies to describe both individual attitudes and structural forms of oppression embedded in social institutions, cultural norms, media narratives, and everyday practices."
    ]
  },
  "notation": [
    "4.1"
  ],
