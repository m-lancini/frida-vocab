{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/independence",
  "type": "Concept",
  "prefLabel": {
    "en": "independence"
  },
  "definition": {
    "en": "The capacity of persons to exercise meaningful control over their lives, make decisions, and pursue their own purposes without being subject to undue domination, coercion, or arbitrary interference."
  },
  "scopeNote": {
    "en": [
      "The normative liberal ideal of a self-sufficient entails a subject who is presumed capable of acting, deciding, and sustaining their life without reliance on others or on supportive social and material conditions. In this view, agency is treated as an individual property and autonomy as a state of detachment from relations of dependence, often obscuring the social, infrastructural, and relational conditions that make action possible. However, in a different view, independence does not require self-sufficiency or the absence of dependence on others. Rather, independence is exercised within relations of interdependence and relies on social, material, institutional, and infrastructural conditions that enable persons to act and participate on terms compatible with dignity and equality"
    ]
  },
  "notation": [
    "1.6"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-1",
    "prefLabel": {
      "en": "Autonomy, participation, care and support"
    }
  },
