{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/alternative-care",
  "type": "Concept",
  "prefLabel": {
    "en": "alternative care"
  },
  "definition": {
    "en": "Forms of care for a child deprived of their family environment, or who cannot remain in it in their own interest: foster care, kafalah, residential care and, as a more permanent measure creating a parent-child bond, adoption."
  },
  "scopeNote": {
    "en": [
      "They are chosen in accordance with the child's best interests and the principles of necessity and suitability, with a preference for family- and community-based solutions. The CRC governs alternative care in art. 20 and adoption in art. 21, complemented by the UN Guidelines for the Alternative Care of Children (2009). For children with disabilities, the CRPD requires preventing their abandonment and segregation, not separating them on the ground of disability and, where they cannot remain with their immediate family, securing their care within the extended family or, failing that, in a family setting within the community (arts. 23.3 to 23.5, in conjunction with art. 19)."
    ]
  },
  "notation": [
    "2.1"
  ],
  "broader": {
    "id": "https://m-lancini.github.io/frida-vocab/dictionary/section-2",
    "prefLabel": {
      "en": "Children, family and parental responsibility"
    }
  },
