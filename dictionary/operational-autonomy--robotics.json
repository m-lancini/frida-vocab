{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/operational-autonomy--robotics",
  "type": "Concept",
  "prefLabel": {
    "en": "operational autonomy (robotics)"
  },
  "definition": {
    "en": "The capacity to operate or make decisions without direct external intervention."
  },
  "scopeNote": {
    "en": [
      "In the context of robotics is the capacity of a system to operate without direct human supervision. It generally refers to the capacity of a system to achieve its stated aim without human intervention and compensating for external influences and interactions."
    ]
  },
  "notation": [
    "12.5"
  ],
  "broader": {
