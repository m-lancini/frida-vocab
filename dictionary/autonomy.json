{
  "id": "https://m-lancini.github.io/frida-vocab/dictionary/autonomy",
  "type": "Concept",
  "prefLabel": {
    "en": "autonomy"
  },
  "definition": {
    "en": "The capacity of persons to shape and pursue their own lives, values, and commitments, and to participate meaningfully in decisions that affect them."
  },
  "scopeNote": {
    "en": [
      "It is not merely freedom from external interference or dependence on others, but a socially and relationally constituted capacity, whose exercise requires adequate material conditions, recognition, supportive relationships, access to knowledge, and protection from domination, manipulation, and oppression."
    ]
  },
  "notation": [
    "1.2"
  ],
